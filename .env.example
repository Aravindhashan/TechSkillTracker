# Copy to .env and fill in your own values.
JSEARCH_API_KEY=
JSEARCH_COUNTRY=in
JSEARCH_QUERIES=software developer
JSEARCH_NUM_PAGES=1
JSEARCH_CHECK_QUOTA=false

# Jobspy is a second, free source (Indeed/Glassdoor). Enabled by default;
# set to false to disable (ToS risk accepted by enabling).
ENABLE_JOBSPY=true

# Production Postgres (Neon/Supabase). Omit to use local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SQLITE_PATH=data/techskill.db
