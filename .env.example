# Copy to .env and fill in your own values.
JSEARCH_API_KEY=
JSEARCH_COUNTRY=in
JSEARCH_QUERIES=software developer
JSEARCH_NUM_PAGES=1
JSEARCH_CHECK_QUOTA=false

# Opt-in scraper (off by default, ToS risk)
ENABLE_JOBSPY=false

# Production Postgres (Neon/Supabase). Omit to use local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SQLITE_PATH=data/techskill.db
